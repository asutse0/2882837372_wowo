function Library:CreateWindow(config)
	config = config or {}

	self.AutoDemo = false

	local window = {}
	window.Library = self
	window.Title = config.Title or "Traceless UI"
	window.Size = config.Size or UDim2.fromOffset(480, 390)
	window.Position = config.Position or UDim2.new(0.5, -240, 0.5, -195)
	window.Tabs = {}
	window.CurrentTab = nil

	local parent = config.Parent or self:GetParent()

	local old = parent:FindFirstChild(config.Name or "TracelessLibraryWindow")

	if old and config.DestroyOld ~= false then
		old:Destroy()
	end

	local gui = make("ScreenGui", {
		Name = config.Name or "TracelessLibraryWindow",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Parent = parent
	})

	local reopenButton = make("TextButton", {
		Size = UDim2.fromOffset(132, 36),
		Position = UDim2.new(1, -146, 0, 14),
		BackgroundColor3 = self.Theme.Button,
		BorderSizePixel = 0,
		Text = "Open Traceless",
		TextColor3 = self.Theme.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
		Visible = false,
		Parent = gui
	})

	corner(reopenButton, 10)
	stroke(reopenButton, self.Theme.StrokeSoft, 1, 0.3)
	hover(reopenButton, self.Theme.Button, self.Theme.ButtonHover)

	local main = make("Frame", {
		Size = window.Size,
		Position = window.Position,
		BackgroundColor3 = self.Theme.Window,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = gui
	})

	corner(main, 16)
	stroke(main, self.Theme.Stroke, 1.25, 0.16)

	make("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 20, 24)),
			ColorSequenceKeypoint.new(0.55, Color3.fromRGB(12, 12, 15)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(7, 7, 9))
		}),
		Rotation = 90,
		Parent = main
	})

	local header = make("Frame", {
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = self.Theme.Header,
		BorderSizePixel = 0,
		Parent = main
	})

	corner(header, 16)

	make("TextLabel", {
		Size = UDim2.new(1, -120, 0, 26),
		Position = UDim2.fromOffset(14, 6),
		BackgroundTransparency = 1,
		Text = window.Title,
		TextColor3 = self.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBold,
		TextSize = 17,
		Parent = header
	})

	make("TextLabel", {
		Size = UDim2.new(1, -120, 0, 17),
		Position = UDim2.fromOffset(15, 31),
		BackgroundTransparency = 1,
		Text = config.Subtitle or Library.Version,
		TextColor3 = self.Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham,
		TextSize = 10,
		Parent = header
	})

	local close = make("TextButton", {
		Size = UDim2.fromOffset(32, 32),
		Position = UDim2.new(1, -42, 0, 11),
		BackgroundColor3 = self.Theme.Button,
		BorderSizePixel = 0,
		Text = "×",
		TextColor3 = self.Theme.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 21,
		AutoButtonColor = false,
		Parent = header
	})

	corner(close, 10)
	hover(close, self.Theme.Button, self.Theme.ButtonHover)

	local tabBar = make("Frame", {
		Size = UDim2.new(0, 112, 1, -64),
		Position = UDim2.fromOffset(8, 60),
		BackgroundColor3 = self.Theme.Panel,
		BorderSizePixel = 0,
		Parent = main
	})

	corner(tabBar, 13)
	stroke(tabBar, self.Theme.StrokeSoft, 1, 0.22)
	padding(tabBar, 7, 7, 7, 7)

	make("UIListLayout", {
		Padding = UDim.new(0, 7),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = tabBar
	})

	local content = make("Frame", {
		Size = UDim2.new(1, -132, 1, -64),
		Position = UDim2.fromOffset(124, 60),
		BackgroundTransparency = 1,
		Parent = main
	})

	function window:Hide()
		tween(main, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 1
		})

		task.delay(0.17, function()
			main.Visible = false
			reopenButton.Visible = true
		end)
	end

	function window:Show()
		main.Visible = true
		reopenButton.Visible = false
		main.Size = UDim2.fromOffset(0, 0)
		main.BackgroundTransparency = 1

		tween(main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = window.Size,
			BackgroundTransparency = 0
		})
	end

	function window:Toggle()
		if main.Visible then
			window:Hide()
		else
			window:Show()
		end
	end

	close.MouseButton1Click:Connect(function()
		window:Hide()
	end)

	reopenButton.MouseButton1Click:Connect(function()
		window:Show()
	end)

	do
		local dragging = false
		local dragStart
		local startPos

		header.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = main.Position
			end
		end)

		header.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if not dragging then
				return
			end

			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			local delta = input.Position - dragStart

			main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end)
	end

	window.Gui = gui
	window.Main = main
	window.ReopenButton = reopenButton
	window.Header = header
	window.TabBar = tabBar
	window.Content = content

	function window:AddTab(tabName)
		local tab = {}
		tab.Window = window
		tab.Name = tabName

		local button = make("TextButton", {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = Library.Theme.Panel2,
			BorderSizePixel = 0,
			Text = tostring(tabName or "Tab"),
			TextColor3 = Library.Theme.Text,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			AutoButtonColor = false,
			Parent = tabBar
		})

		corner(button, 9)
		hover(button, Library.Theme.Panel2, Library.Theme.Panel3)

		local page = make("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
