		Size = UDim2.new(1, -132, 1, -64),
		Position = UDim2.fromOffset(124, 60),
		BackgroundTransparency = 1,
		Parent = main
	})

	function window:Hide()
		tween(main, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 1
		})

		task.delay(0.17, function()
			main.Visible = false
			reopenButton.Visible = true
		end)
	end

	function window:Show()
		main.Visible = true
		reopenButton.Visible = false
		main.Size = UDim2.fromOffset(0, 0)
		main.BackgroundTransparency = 1

		tween(main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = window.Size,
			BackgroundTransparency = 0
		})
	end

	function window:Toggle()
		if main.Visible then
			window:Hide()
		else
			window:Show()
		end
	end

	close.MouseButton1Click:Connect(function()
		window:Hide()
	end)

	reopenButton.MouseButton1Click:Connect(function()
		window:Show()
	end)

	do
		local dragging = false
		local dragStart
		local startPos

		header.InputBegan:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = inputObject.Position
				startPos = main.Position
			end
		end)

		header.InputEnded:Connect(function(inputObject)
			if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)

		UserInputService.InputChanged:Connect(function(inputObject)
			if not dragging then
				return
			end

			if inputObject.UserInputType ~= Enum.UserInputType.MouseMovement and inputObject.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			local delta = inputObject.Position - dragStart

			main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end)
	end

	window.Gui = gui
	window.Main = main
	window.ReopenButton = reopenButton
	window.Header = header
	window.TabBar = tabBar
	window.Content = content

	function window:AddTab(tabName)
