function Library:SetApiKeys(keys)
	self.ApiKeys = normalizeApiKeys(keys or {})

	self.DefaultApiKey = self.ApiKeys[1] or self.DefaultApiKey or ""
	self.BackupApiKey = self.ApiKeys[2] or ""

	for _, chat in ipairs(self.Chats) do
		if chat.SetApiKeys then
			chat:SetApiKeys(self.ApiKeys)
		end
	end

	return self
end

function Library:SetApiKey(key)
	key = tostring(key or "")
	self.DefaultApiKey = key

	if #self.ApiKeys == 0 then
		self.ApiKeys = normalizeApiKeys({ key })
	else
		self.ApiKeys[1] = key
		self.ApiKeys = normalizeApiKeys(self.ApiKeys)
	end

	for _, chat in ipairs(self.Chats) do
		if chat.SetApiKey then
			chat:SetApiKey(key)
		end
	end

	return self
end

function Library:SetBackupApiKey(key)
	key = tostring(key or "")
	self.BackupApiKey = key

	if #self.ApiKeys == 0 then
		self.ApiKeys = normalizeApiKeys({ self.DefaultApiKey, key })
	else
		self.ApiKeys[2] = key
		self.ApiKeys = normalizeApiKeys(self.ApiKeys)
	end

	for _, chat in ipairs(self.Chats) do
		if chat.SetBackupApiKey then
			chat:SetBackupApiKey(key)
		end
	end

	return self
end

function Library:SetAllowedModelUsers(config)
	self.AllowedModelUsers = config or {
		UserIds = {},
		Names = {}
	}

	for _, chat in ipairs(self.Chats) do
		if chat.SetAllowedModelUsers then
			chat:SetAllowedModelUsers(self.AllowedModelUsers)
		end
	end

	return self
end

