function Library:GetParent()
	if gethui then
		local ok, result = pcall(gethui)

		if ok and result then
			return result
		end
	end

	if CoreGui then
		return CoreGui
	end

	return LocalPlayer:WaitForChild("PlayerGui")
end

function Library:Notify(titleText, message, duration)
	duration = duration or 3

	local parent = self:GetParent()
	local gui = parent:FindFirstChild("TracelessLibraryNotifications")

	if not gui then
		gui = make("ScreenGui", {
			Name = "TracelessLibraryNotifications",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			Parent = parent
		})
	end

	local frame = make("Frame", {
		Size = UDim2.fromOffset(300, 72),
		Position = UDim2.new(1, -318, 1, -90),
		BackgroundColor3 = self.Theme.Panel,
		BorderSizePixel = 0,
		Parent = gui
	})

	corner(frame, 13)
	stroke(frame, self.Theme.Stroke, 1, 0.25)

	local titleLabel = make("TextLabel", {
		Size = UDim2.new(1, -22, 0, 22),
		Position = UDim2.fromOffset(11, 7),
		BackgroundTransparency = 1,
		Text = tostring(titleText or "Notice"),
		TextColor3 = self.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		Parent = frame
	})

	local msgLabel = make("TextLabel", {
		Size = UDim2.new(1, -22, 0, 34),
		Position = UDim2.fromOffset(11, 30),
		BackgroundTransparency = 1,
		Text = tostring(message or ""),
		TextColor3 = self.Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		Parent = frame
	})

	frame.BackgroundTransparency = 1
	titleLabel.TextTransparency = 1
	msgLabel.TextTransparency = 1

	tween(frame, TweenInfo.new(0.16), {
		BackgroundTransparency = 0
	})

	tween(titleLabel, TweenInfo.new(0.16), {
		TextTransparency = 0
	})

	tween(msgLabel, TweenInfo.new(0.16), {
		TextTransparency = 0
	})

	task.delay(duration, function()
		if frame then
			tween(frame, TweenInfo.new(0.18), {
				BackgroundTransparency = 1
			})

			tween(titleLabel, TweenInfo.new(0.18), {
				TextTransparency = 1
			})

			tween(msgLabel, TweenInfo.new(0.18), {
				TextTransparency = 1
			})

			task.wait(0.2)
			frame:Destroy()
		end
	end)
end

