				BorderSizePixel = 0,
				Text = tostring(config.Default or (config.Options and config.Options[1]) or "Select"),
				TextColor3 = Library.Theme.Text,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				AutoButtonColor = false,
