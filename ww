	local function addTracelessResponse(text)
		text = tostring(text or "")
		chat.LastReply = text

		local segments = parseMarkdownCodeBlocks(text)
		local hasCode = false

		for _, seg in ipairs(segments) do
			if seg.Type == "code" then
				hasCode = true
				break
			end
		end

		if not hasCode then
			addBubble("Traceless", text, "ai", true)
			return
		end

		for _, seg in ipairs(segments) do
			if seg.Type == "text" then
				local clean = trim(seg.Text)

				if clean ~= "" then
					addBubble("Traceless", clean, "ai", false)
				end
			elseif seg.Type == "code" then
				addCodeBlock(seg.Language, seg.Code)
			end
		end
	end

	local function extractApiText(decoded)
		local candidates = decoded and decoded.candidates

		if type(candidates) ~= "table" or not candidates[1] then
			return nil
		end

		local content = candidates[1].content

		if type(content) ~= "table" then
			return nil
		end

		local parts = content.parts

		if type(parts) ~= "table" then
			return nil
		end

		local result = ""

		for _, part in ipairs(parts) do
			if type(part) == "table" and type(part.text) == "string" then
				result ..= part.text
			end
		end

		return result ~= "" and result or nil
	end

	local function isSuccess(response)
		if type(response) ~= "table" then
			return false
		end

		if response.Success == true or response.success == true then
			return true
		end

		local status = response.StatusCode or response.Status or response.status

		return type(status) == "number" and status >= 200 and status < 300
	end

	local function getBody(response)
		if type(response) ~= "table" then
			return nil
		end

		return response.Body or response.body or response.Response or response.response
	end

	local function getStatus(response)
		if type(response) ~= "table" then
			return "unknown"
		end

		return response.StatusCode or response.Status or response.status or "unknown"
	end

	local function buildPrompt(message)
		local finalMessage = tostring(message or "")

		if isModelIdentityQuestion(finalMessage) then
			finalMessage =
				"The user is asking about your identity/model. Reply exactly as Traceless. " ..
				"Do not mention Gemini, Google, ChatGPT, OpenAI, or internal model/API names.\n\n" ..
				"User message:\n" ..
				finalMessage
		end

		if isCodingRequest(finalMessage) then
			finalMessage =
				"The user is asking for code/scripting. Follow these extra rules:\n" ..
				"- Strictly use Roblox Luau.\n" ..
				"- Prefer complete LocalScripts.\n" ..
				"- Wrap code in ```lua code blocks.\n" ..
				"- Do not switch to Python, JavaScript, HTML, ModuleScript, or ServerScript unless explicitly asked.\n\n" ..
				"User message:\n" ..
				finalMessage
		end

		if chat.SelectedContext ~= "" and not string.find(finalMessage, "[Selected Game Item]", 1, true) then
			finalMessage ..= "\n\nRelevant selected game item context:\n" .. chat.SelectedContext
		end

		return finalMessage
	end

	local function doRequest(message, apiKeyToUse)
		if not apiKeyToUse or apiKeyToUse == "" or apiKeyToUse == "PASTE_PRIMARY_API_KEY_HERE" then
			return false, "NO_API_KEY", "API key is missing."
		end

		local url = "https://generativelanguage.googleapis.com/v1beta/models/"
			.. encode(chat.Model)
			.. ":generateContent?key="
			.. encode(apiKeyToUse)

		local payload = {
			systemInstruction = {
				parts = {
					{ text = chat.SystemPrompt }
				}
			},

			contents = {
				{
					role = "user",
					parts = {
						{ text = buildPrompt(message) }
					}
				}
			},

			generationConfig = {
				temperature = config.Temperature or 0.8,
				topP = config.TopP or 0.95,
				maxOutputTokens = chat.MaxOutputTokens
			}
		}

		local encodedBody = HttpService:JSONEncode(payload)

		local ok, response = pcall(function()
			return request({
				Url = url,
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json"
				},
				Body = encodedBody
			})
		end)

		if not ok then
			return false, "REQUEST_ERROR", tostring(response)
		end

		if not isSuccess(response) then
			return false, "HTTP_" .. tostring(getStatus(response)), tostring(getBody(response))
		end

		local body = getBody(response)

		if type(body) ~= "string" then
			return false, "EMPTY_BODY", "No body"
		end

		local decodeOk, decoded = pcall(function()
			return HttpService:JSONDecode(body)
		end)

		if not decodeOk then
			return false, "DECODE_ERROR", tostring(decoded)
		end

		local text = extractApiText(decoded)

		if not text then
			return false, "NO_TEXT", body
		end

		return true, text, nil
	end

	local modelIndex = 1

	modelButton.MouseButton1Click:Connect(function()
		modelIndex += 1

		if modelIndex > #chat.Models then
			modelIndex = 1
		end

		local chosen = chat.Models[modelIndex]
		local allowed = isAllowedUser(chat.AllowedModelUsers)

		if chosen ~= chat.BasicModel and not allowed then
			Library:Notify("Model locked", "You can only use the basic Traceless model.", 3)
			chosen = chat.BasicModel
			modelIndex = 1
		elseif chosen ~= chat.BasicModel then
			Library:Notify("Token warning", "Stronger models may use more tokens and cost more.", 3)
		end

		chat.Model = chosen
		modelButton.Text = "Model: " .. getDisplayModelName(chat.Model)
	end)

	local busy = false

	local function finishSend()
		busy = false
		send.Text = "Send"
		send.BackgroundColor3 = Library.Theme.Accent
	end

	local function getApiList()
		local list = {}
		local keys = normalizeApiKeys(chat.ApiKeys)

		if #keys == 0 then
			keys = normalizeApiKeys({
				chat.ApiKey,
				chat.BackupApiKey
			})
		end

		for index, key in ipairs(keys) do
			table.insert(list, {
				Name = index == 1 and "Primary" or ("Backup " .. tostring(index - 1)),
				Key = key
			})
		end

		return list
	end

	local function sendMessage()
		if busy then
			return
		end

		local message = trim(input.Text)

		if message == "" then
			addBubble("System", "Type something first.", "system", false)
			return
		end

		if type(request) ~= "function" then
			addBubble("System", "request() was not found in this environment.", "error", false)
			return
		end

		input.Text = ""

		addBubble("You", message, "user", false)

		busy = true
		send.Text = "..."
		send.BackgroundColor3 = Library.Theme.Button

		local thinking = addBubble("Traceless", "Thinking...", "system", false)

		task.spawn(function()
			local lastError = nil
			local apiList = getApiList()

			if #apiList == 0 then
				if thinking then
					thinking:Destroy()
				end

				addBubble("System", "No Traceless API keys are set.", "error", false)
				finishSend()
				return
			end

			for _, apiData in ipairs(apiList) do
				for attempt = 1, chat.MaxRetries + 1 do
					local ok, result, err = doRequest(message, apiData.Key)

					if ok then
						if thinking then
							thinking:Destroy()
						end

						if apiData.Name ~= "Primary" then
							addBubble("System", "Primary API failed, but " .. apiData.Name .. " worked.", "system", false)
						end

						addTracelessResponse(result)
						finishSend()
						return
					end

					lastError = apiData.Name .. " API failed: " .. tostring(result) .. " " .. tostring(err)
					warn("[Traceless UI] " .. lastError)

					if result == "HTTP_400" or result == "HTTP_401" or result == "HTTP_403" or result == "NO_API_KEY" then
						break
					end

					task.wait(1)
				end
			end

			if thinking then
				thinking:Destroy()
			end

			addBubble("System", "The Traceless APIs are not working right now. All API keys failed.", "error", false)
			warn("[Traceless UI] All APIs failed:", lastError)

			finishSend()
		end)
	end

	send.MouseButton1Click:Connect(sendMessage)

	input.FocusLost:Connect(function(enterPressed)
		if enterPressed and not UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			sendMessage()
		end
	end)

	copyButton.MouseButton1Click:Connect(function()
		if chat.LastReply == "" then
			Library:Notify("Nothing to copy", "No Traceless reply yet.", 2)
			return
		end

		if safeClipboard(chat.LastReply) then
			copyButton.Text = "Copied!"
		else
			copyButton.Text = "No Clip"
		end

		task.delay(1, function()
			if copyButton then
				copyButton.Text = "Copy"
			end
		end)
	end)

	clearContext.MouseButton1Click:Connect(function()
		chat.SelectedContext = ""
		Library:Notify("Context cleared", "Selected object context was cleared.", 2)
	end)

	pickButton.MouseButton1Click:Connect(function()
		Library:StartObjectPicker({
			OnConfirm = function(instance)
				local info = getObjectInfo(instance)
				chat.SelectedContext = info

				local insertText =
					"\n\n[Selected Game Item]\n" ..
					"FullName: " .. instance:GetFullName() .. "\n" ..
					"LuaPath: " .. makeSafeLuaPath(instance) .. "\n" ..
					"ClassName: " .. instance.ClassName .. "\n\n" ..
					"What should I do with this item?\n"

				if trim(input.Text) == "" then
					input.Text = insertText
				else
					input.Text ..= insertText
				end

				Library:Notify("Item selected", instance:GetFullName(), 3)
				input:CaptureFocus()
			end
		})
	end)

	function chat:SetApiKeys(keys)
		chat.ApiKeys = normalizeApiKeys(keys or {})
		chat.ApiKey = chat.ApiKeys[1] or chat.ApiKey
		chat.BackupApiKey = chat.ApiKeys[2] or chat.BackupApiKey
		return chat
	end

	function chat:SetApiKey(key)
		key = tostring(key or "")
		chat.ApiKey = key

		if #chat.ApiKeys == 0 then
			chat.ApiKeys = normalizeApiKeys({ key })
		else
			chat.ApiKeys[1] = key
			chat.ApiKeys = normalizeApiKeys(chat.ApiKeys)
		end

		return chat
	end

	function chat:SetBackupApiKey(key)
		key = tostring(key or "")
		chat.BackupApiKey = key

		if #chat.ApiKeys == 0 then
			chat.ApiKeys = normalizeApiKeys({ chat.ApiKey, key })
		else
			chat.ApiKeys[2] = key
			chat.ApiKeys = normalizeApiKeys(chat.ApiKeys)
		end

		return chat
	end

	function chat:AddApiKey(key)
		key = tostring(key or "")

		if key ~= "" then
			table.insert(chat.ApiKeys, key)
			chat.ApiKeys = normalizeApiKeys(chat.ApiKeys)
		end

		return chat
	end

	function chat:GetApiKeys()
		return copyArray(chat.ApiKeys)
	end

	function chat:SetAllowedModelUsers(config)
		chat.AllowedModelUsers = config or {
			UserIds = {},
			Names = {}
		}

		return chat
	end

	function chat:SetModel(model)
		chat.Model = tostring(model or chat.BasicModel)
		modelButton.Text = "Model: " .. getDisplayModelName(chat.Model)
		return chat
	end

	function chat:SetBasicModel(model)
		chat.BasicModel = tostring(model or "gemini-2.5-flash")
		return chat
	end

	function chat:SetModels(models)
		chat.Models = models or chat.Models
		return chat
	end

	function chat:AppendToInput(text)
		input.Text ..= tostring(text or "")
		return chat
	end

	function chat:GetInput()
		return input.Text
	end

	function chat:SetInput(text)
		input.Text = tostring(text or "")
		return chat
	end

	function chat:AddMessage(senderName, text, kind)
		return addBubble(senderName, text, kind or "system", false)
	end

	function chat:GetSelectedContext()
		return chat.SelectedContext
	end

	function chat:ClearSelectedContext()
		chat.SelectedContext = ""
		return chat
	end

	addBubble("System", "Traceless chat loaded. Select Item inserts object context into your textbox.", "system", false)

	return chat
end

