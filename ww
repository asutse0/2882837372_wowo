	local function clearOutput()
		for _, child in ipairs(output:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end

		chat.LastReply = ""
	end

	local function addBubble(senderName, text, kind, animate)
		text = tostring(text or "")

		local color = Library.Theme.Panel2

		if kind == "user" then
			color = Color3.fromRGB(44, 44, 50)
		elseif kind == "error" then
			color = Library.Theme.Error
		elseif kind == "system" then
			color = Color3.fromRGB(35, 35, 40)
		end

		local bubbleWidth = output.AbsoluteSize.X > 50 and (output.AbsoluteSize.X - 36) or 350
		local full = senderName .. ": " .. text
		local height = getTextHeight(full, 12, Enum.Font.Gotham, bubbleWidth, 36, 2000)

		local holder = make("Frame", {
			Size = UDim2.new(1, 0, 0, height),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Parent = output
		})

		local box = make("TextBox", {
			Size = UDim2.new(kind == "user" and 0.88 or 0.96, 0, 0, height),
			Position = kind == "user" and UDim2.new(0.12, 0, 0, 0) or UDim2.fromOffset(0, 0),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Text = animate and (senderName .. ": ") or full,
			TextColor3 = Library.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			TextEditable = false,
			MultiLine = true,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			Parent = holder
		})

		corner(box, 11)
		stroke(box, Library.Theme.StrokeSoft, 1, 0.5)
		padding(box, 9, 9, 7, 7)

		holder.Position = UDim2.fromOffset(0, 8)

		tween(holder, TweenInfo.new(0.14), {
			Position = UDim2.fromOffset(0, 0)
		})

		scrollBottom()

		if animate then
			task.spawn(function()
				local step = #text > 1000 and 20 or 7

				for i = 1, #text, step do
					box.Text = senderName .. ": " .. text:sub(1, i + step)
					scrollBottom()
					task.wait(0.006)
				end

				box.Text = full
			end)
		end

		return holder
	end

	local function addCodeBlock(language, code)
		language = trim(language)
		code = tostring(code or "")

		if language == "" then
			language = "lua"
		end

		local lines = 1
		local longest = 0

		for line in (code .. "\n"):gmatch("(.-)\n") do
			lines += 1
			longest = math.max(longest, #line)
		end

		lines = math.max(1, lines - 1)

		local contentHeight = math.max(125, lines * 18 + 30)
		local viewHeight = math.clamp(contentHeight, 125, 300)
		local holderHeight = viewHeight + 48
		local canvasWidth = math.max(680, longest * 8 + 60)

		local holder = make("Frame", {
			Size = UDim2.new(1, 0, 0, holderHeight),
			BackgroundTransparency = 1,
			Parent = output
		})

