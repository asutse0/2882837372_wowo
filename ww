local function tween(instance, info, props)
	local tw = TweenService:Create(instance, info, props)
	tw:Play()
	return tw
end

local function make(className, props, children)
	local obj = Instance.new(className)

	for k, v in pairs(props or {}) do
		obj[k] = v
	end

	for _, child in ipairs(children or {}) do
		child.Parent = obj
	end

	return obj
end

local function corner(parent, radius)
	return make("UICorner", {
		CornerRadius = UDim.new(0, radius or 10),
		Parent = parent
	})
end

local function stroke(parent, color, thickness, transparency)
	return make("UIStroke", {
		Color = color or Library.Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0.25,
		Parent = parent
	})
end

local function padding(parent, left, right, top, bottom)
	return make("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent
	})
end

local function trim(text)
	text = tostring(text or "")
	return text:match("^%s*(.-)%s*$")
end

local function encode(value)
	return HttpService:UrlEncode(tostring(value))
end

local function safeClipboard(text)
	text = tostring(text or "")

	if type(setclipboard) == "function" then
		setclipboard(text)
		return true
	end

	if type(toclipboard) == "function" then
		toclipboard(text)
		return true
	end

	if type(set_clipboard) == "function" then
		set_clipboard(text)
		return true
	end

	return false
end

local function hover(button, normal, over)
	button.MouseEnter:Connect(function()
		tween(button, TweenInfo.new(0.12), {
			BackgroundColor3 = over
		})
	end)

	button.MouseLeave:Connect(function()
		tween(button, TweenInfo.new(0.12), {
			BackgroundColor3 = normal
		})
	end)
end

local function getTextHeight(text, textSize, font, width, minHeight, maxHeight)
	local ok, size = pcall(function()
		return TextService:GetTextSize(
			tostring(text or ""),
			textSize,
			font,
			Vector2.new(math.max(width or 100, 60), 100000)
		)
	end)

	if not ok then
		return minHeight or 40
	end

	local height = size.Y + 26

	if minHeight then
		height = math.max(height, minHeight)
	end

	if maxHeight then
		height = math.min(height, maxHeight)
	end

	return height
end

local function copyArray(array)
	local result = {}

	for _, value in ipairs(array or {}) do
		table.insert(result, value)
	end

	return result
end

local function normalizeApiKeys(keys)
	local result = {}
	local seen = {}

	for _, key in ipairs(keys or {}) do
		key = tostring(key or "")

		if key ~= "" and key ~= "PASTE_PRIMARY_API_KEY_HERE" and not seen[key] then
			seen[key] = true
			table.insert(result, key)
		end
	end

	return result
end

local function isAllowedUser(allowed)
	if not LocalPlayer then
		return false
	end

	allowed = allowed or {}

	for _, userId in ipairs(allowed.UserIds or {}) do
		if tonumber(userId) == LocalPlayer.UserId then
			return true
		end
	end

	for _, name in ipairs(allowed.Names or {}) do
		if tostring(name):lower() == LocalPlayer.Name:lower() then
			return true
		end
	end

	return false
end

local function parseMarkdownCodeBlocks(text)
	text = tostring(text or "")

	local segments = {}
	local index = 1

	while true do
		local startFence = text:find("```", index, true)

		if not startFence then
			local remaining = text:sub(index)

			if remaining ~= "" then
				table.insert(segments, {
					Type = "text",
					Text = remaining
				})
			end

			break
		end

		if startFence > index then
			table.insert(segments, {
				Type = "text",
				Text = text:sub(index, startFence - 1)
			})
		end

		local afterFence = startFence + 3
		local lineEnd = text:find("\n", afterFence, true)

		local language = "lua"
		local codeStart = afterFence

		if lineEnd then
			local maybeLanguage = trim(text:sub(afterFence, lineEnd - 1))

			if maybeLanguage ~= "" then
				language = maybeLanguage
			end

			codeStart = lineEnd + 1
		end

		local endFence = text:find("```", codeStart, true)

		if not endFence then
			table.insert(segments, {
				Type = "text",
				Text = text:sub(startFence)
			})

			break
		end

		local code = text:sub(codeStart, endFence - 1)
		code = code:gsub("^%s*\n", "")
		code = code:gsub("\n%s*$", "")

		table.insert(segments, {
			Type = "code",
			Language = language,
			Code = code
		})

		index = endFence + 3
	end

	return segments
end

local function getServiceName(instance)
	local services = {
		[Workspace] = "Workspace",
		[ReplicatedStorage] = "ReplicatedStorage",
		[Players] = "Players",
		[Lighting] = "Lighting",
		[StarterGui] = "StarterGui",
		[StarterPack] = "StarterPack",
		[StarterPlayer] = "StarterPlayer",
		[SoundService] = "SoundService",
		[Teams] = "Teams"
	}

	return services[instance]
end

local function makeSafeLuaPath(instance)
	if not instance then
		return "nil"
	end

	local chain = {}
	local current = instance

	while current and current ~= game do
		table.insert(chain, 1, current)
		current = current.Parent
	end

	local root = chain[1]

	if not root then
		return "nil"
	end

	local rootService = getServiceName(root)
	local path

	if rootService then
		path = ('game:GetService("%s")'):format(rootService)
	else
		path = "game"
	end

	local startIndex = rootService and 2 or 1

	for i = startIndex, #chain do
		local safeName = chain[i].Name:gsub("\\", "\\\\"):gsub('"', '\\"')
		path ..= (':WaitForChild("%s")'):format(safeName)
	end

	return path
end

local function getObjectInfo(instance)
	if not instance then
		return ""
	end

	local lines = {
		"Selected object:",
		"Name: " .. instance.Name,
		"ClassName: " .. instance.ClassName,
		"FullName: " .. instance:GetFullName(),
		"LuaPath: " .. makeSafeLuaPath(instance)
	}

	if instance:IsA("BasePart") then
		table.insert(lines, ("Position: %.2f, %.2f, %.2f"):format(instance.Position.X, instance.Position.Y, instance.Position.Z))
		table.insert(lines, ("Size: %.2f, %.2f, %.2f"):format(instance.Size.X, instance.Size.Y, instance.Size.Z))
		table.insert(lines, "Anchored: " .. tostring(instance.Anchored))
		table.insert(lines, "CanCollide: " .. tostring(instance.CanCollide))
		table.insert(lines, "Transparency: " .. tostring(instance.Transparency))
	end

	local children = instance:GetChildren()

	if #children > 0 then
		table.insert(lines, "Children:")

		for i = 1, math.min(#children, 20) do
			local child = children[i]
			table.insert(lines, "- " .. child.Name .. " [" .. child.ClassName .. "]")
		end
	end

	return table.concat(lines, "\n")
end

local function isCodingRequest(message)
	local lower = string.lower(tostring(message or ""))

	local keywords = {
		"code",
		"script",
		"scripting",
		"localscript",
		"local script",
		"lua",
		"luau",
		"roblox",
		"debug",
		"fix",
		"error",
		"full script",
		"gui",
		"ui",
		"request",
		"function",
		"remote",
		"tween",
		"highlight"
	}

	for _, keyword in ipairs(keywords) do
		if string.find(lower, keyword, 1, true) then
			return true
		end
	end

	return false
end

local function isModelIdentityQuestion(message)
	local lower = string.lower(tostring(message or ""))

	local patterns = {
		"what model",
		"which model",
		"what ai",
		"which ai",
		"who are you",
		"what are you",
		"are you gemini",
		"are you chatgpt",
		"language model",
		"model are you",
		"ai are you",
		"what llm",
		"which llm",
		"what language model",
		"what is your model",
		"what's your model"
	}

	for _, pattern in ipairs(patterns) do
		if string.find(lower, pattern, 1, true) then
			return true
		end
	end

	return false
end

