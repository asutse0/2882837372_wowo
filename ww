			button.MouseButton1Click:Connect(function()
				if #dropdown.Options == 0 then
					return
				end

				index += 1

				if index > #dropdown.Options then
					index = 1
				end

				dropdown.Value = dropdown.Options[index]
				button.Text = dropdown.Value

				if config.Callback then
					task.spawn(config.Callback, dropdown.Value)
				end
			end)

			function dropdown:Set(value)
				dropdown.Value = tostring(value)
				button.Text = dropdown.Value

				if config.Callback then
					task.spawn(config.Callback, dropdown.Value)
				end
			end

			return dropdown
