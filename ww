	local function addTracelessResponse(text)
		text = tostring(text or "")
		chat.LastReply = text

		local segments = parseMarkdownCodeBlocks(text)
		local hasCode = false

		for _, seg in ipairs(segments) do
			if seg.Type == "code" then
				hasCode = true
				break
			end
		end

		if not hasCode then
			addBubble("Traceless", text, "ai", true)
			return
		end

		for _, seg in ipairs(segments) do
			if seg.Type == "text" then
				local clean = trim(seg.Text)

				if clean ~= "" then
					addBubble("Traceless", clean, "ai", false)
				end
			elseif seg.Type == "code" then
				addCodeBlock(seg.Language, seg.Code)
			end
		end
	end

	local function decodeBody(response)
		local body = nil

		if type(response) == "table" then
			body = response.Body or response.body or response.Response or response.response
		end

		if type(body) ~= "string" then
			return nil, "No response body."
		end

		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(body)
		end)

		if not ok or type(decoded) ~= "table" then
			return nil, "Invalid JSON response."
		end

		return decoded, nil
	end

	local function postWorker(path, data)
		local workerUrl = cleanWorkerUrl()

		if workerUrl == "" or workerUrl == "https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev" then
			return false, {
				reply = "Cloudflare Worker URL is not set.",
				error = "Cloudflare Worker URL is not set.",
				code = "NO_WORKER_URL"
			}
		end

		local requestFunction = getRequestFunction()

		if not requestFunction then
			return false, {
				reply = "request() was not found in this environment.",
				error = "request() was not found in this environment.",
				code = "NO_REQUEST"
			}
		end

		local ok, response = pcall(function()
			return requestFunction({
				Url = workerUrl .. path,
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json"
				},
				Body = HttpService:JSONEncode(data)
			})
		end)

		if not ok then
			return false, {
				reply = "Request failed before reaching Cloudflare.",
				error = tostring(response),
				code = "REQUEST_ERROR"
			}
		end

		local decoded, decodeError = decodeBody(response)

		if not decoded then
			return false, {
				reply = decodeError or "Bad response.",
				error = decodeError or "Bad response.",
				code = "BAD_RESPONSE"
			}
		end

		if decoded.reply == nil then
			decoded.reply = decoded.error or ""
		end

		return decoded.success == true, decoded
	end

	local function registerWithWorker(showResult)
		if not LocalPlayer then
			return
		end

		local ok, decoded = postWorker("/register", {
			userId = LocalPlayer.UserId,
			username = LocalPlayer.Name
		})

		if ok then
			local plan = decoded.user and decoded.user.plan or chat.CurrentPlan
			local left = decoded.user and decoded.user.requestsLeft

			if plan and plan ~= "" then
				chat.CurrentPlan = tostring(plan)
				refreshPlanText()
			end

			if left ~= nil then
				setApiStatus("Cloudflare | " .. tostring(left) .. " left", Library.Theme.Success)
			else
				setApiStatus("Cloudflare ready", Library.Theme.Success)
			end

			if showResult then
				addBubble("System", tostring(decoded.reply or "Registered."), "system", false)
			end
		else
			local message = tostring(decoded.reply or decoded.error or "Could not register.")
			setApiStatus("Cloudflare check failed", Library.Theme.Warning)

			if showResult then
				addBubble("System", message, "error", false)
			end
		end

		return ok, decoded
	end

	local function sendToWorker(message)
		return postWorker("/chat", {
			userId = LocalPlayer and LocalPlayer.UserId or 0,
			username = LocalPlayer and LocalPlayer.Name or "Unknown",
			message = tostring(message or ""),
			selectedContext = tostring(chat.SelectedContext or "")
		})
	end

	local function buildPlanMenu()
		for _, child in ipairs(planMenu:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		local plans = {
			{ Id = "basic", Name = "Basic" },
			{ Id = "pro", Name = "Pro" }
		}

		for _, planData in ipairs(plans) do
			local button = make("TextButton", {
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundColor3 = chat.CurrentPlan == planData.Id and Library.Theme.Accent or Library.Theme.Button,
				BorderSizePixel = 0,
				Text = planData.Name,
				TextColor3 = Library.Theme.Text,
				Font = Enum.Font.GothamBold,
				TextSize = 10,
				AutoButtonColor = false,
				ZIndex = 62,
				Parent = planMenu
			})

			corner(button, 8)
			hover(button, button.BackgroundColor3, Library.Theme.ButtonHover)

			button.MouseButton1Click:Connect(function()
				chat:SetCurrentPlan(planData.Id)
				planMenu.Visible = false
				buildPlanMenu()
				registerWithWorker(true)
			end)
		end
	end

	planButton.MouseButton1Click:Connect(function()
		planMenu.Visible = false
		Library:Notify("Plan checked by server", "Cloudflare checks your saved D1 plan and updates this label automatically.", 3)
	end)

	local busy = false

	local function finishSend()
		busy = false
		send.Text = "Send"
		send.BackgroundColor3 = Library.Theme.Accent
	end

	local function sendMessage()
		if busy then
			return
		end

		local message = trim(input.Text)

		if message == "" then
			addBubble("System", "Type something first.", "system", false)
			return
		end

		if isImageGenerationRequest(message) then
			addBubble("System", "Image generation is disabled in Traceless. I can help with Roblox coding or normal chat instead.", "error", false)
			return
		end

		input.Text = ""

		addBubble("You", message, "user", false)

		busy = true
		send.Text = "..."
		send.BackgroundColor3 = Library.Theme.Button

		local thinking = addBubble("Traceless", "Thinking...", "system", false)
		setApiStatus("Cloudflare sending", Library.Theme.Warning)

		task.spawn(function()
			local ok, decoded = sendToWorker(message)

			if thinking then
				thinking:Destroy()
			end

			local reply = tostring(decoded.reply or decoded.error or "")

			if ok then
				local plan = decoded.plan or decoded.previousPlan
				local requestsLeft = decoded.requestsLeft

				if plan and plan ~= "" then
					chat.CurrentPlan = tostring(plan)
					refreshPlanText()
				end

				if requestsLeft ~= nil then
					setApiStatus("Cloudflare | " .. tostring(requestsLeft) .. " left", Library.Theme.Success)
				else
					setApiStatus("Cloudflare ready", Library.Theme.Success)
				end

				addTracelessResponse(reply)

				if decoded.accessRemoved == true then
					addBubble("System", tostring(decoded.statusMessage or "Your request limit has been reached. Your plan access was removed."), "system", false)
				end
			else
				setApiStatus(tostring(decoded.code or "Failed"), Library.Theme.Error)

				if reply == "" then
					reply = "Traceless APIs are not currently working."
				end

				addBubble("System", reply, "error", false)
			end

			finishSend()
		end)
	end

	send.MouseButton1Click:Connect(sendMessage)

	input.FocusLost:Connect(function(enterPressed)
		if enterPressed and not UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			sendMessage()
		end
	end)

	copyButton.MouseButton1Click:Connect(function()
		if chat.LastReply == "" then
			Library:Notify("Nothing to copy", "No Traceless reply yet.", 2)
			return
		end

		if safeClipboard(chat.LastReply) then
			copyButton.Text = "Copied!"
		else
			copyButton.Text = "No Clip"
		end

		task.delay(1, function()
			if copyButton then
				copyButton.Text = "Copy"
			end
		end)
	end)

	clearChatButton.MouseButton1Click:Connect(function()
		clearOutput()
		addBubble("System", "Chat cleared.", "system", false)
	end)

	clearContext.MouseButton1Click:Connect(function()
		chat.SelectedContext = ""
		Library:Notify("Context cleared", "Selected object context was cleared.", 2)
	end)

	pickButton.MouseButton1Click:Connect(function()
		Library:StartObjectPicker({
			OnConfirm = function(instance)
				local info = getObjectInfo(instance)
				chat.SelectedContext = info

				local insertText =
					"\n\n[Selected Game Item]\n" ..
					"FullName: " .. instance:GetFullName() .. "\n" ..
					"LuaPath: " .. makeSafeLuaPath(instance) .. "\n" ..
					"ClassName: " .. instance.ClassName .. "\n\n" ..
					"What should I do with this item?\n"

				if trim(input.Text) == "" then
					input.Text = insertText
				else
					input.Text ..= insertText
				end

				Library:Notify("Item selected", instance:GetFullName(), 3)
				input:CaptureFocus()
			end
		})
	end)

	function chat:SetWorkerUrl(url)
		chat.WorkerUrl = tostring(url or "")
		Library.WorkerUrl = chat.WorkerUrl
		return chat
	end

	function chat:GetWorkerUrl()
		return chat.WorkerUrl
	end

	function chat:SetCurrentPlan(plan)
		-- Backward compatibility only.
		-- The client does not send CurrentPlan anymore.
		chat.CurrentPlan = string.lower(tostring(plan or "none"))
		Library.CurrentPlan = chat.CurrentPlan
		refreshPlanText()
		return chat
	end

	function chat:GetCurrentPlan()
		return chat.CurrentPlan
	end

	function chat:Register()
		return registerWithWorker(true)
	end

	function chat:AppendToInput(text)
		input.Text ..= tostring(text or "")
		return chat
	end

	function chat:GetInput()
		return input.Text
	end

	function chat:SetInput(text)
		input.Text = tostring(text or "")
		return chat
	end

	function chat:AddMessage(senderName, text, kind)
		return addBubble(senderName, text, kind or "system", false)
	end

	function chat:ClearChat()
		clearOutput()
		addBubble("System", "Chat cleared.", "system", false)
		return chat
	end

	function chat:SetApiStatus(text)
		setApiStatus(text, Library.Theme.Muted)
		return chat
	end

	function chat:GetSelectedContext()
		return chat.SelectedContext
	end

	function chat:ClearSelectedContext()
		chat.SelectedContext = ""
		return chat
	end

	buildPlanMenu()
	refreshPlanText()
	addBubble("System", "Traceless chat loaded through Cloudflare. Plan/status is checked by the Worker.", "system", false)

	if chat.AutoRegister then
		task.spawn(function()
			task.wait(0.25)
			registerWithWorker(false)
		end)
	end

	return chat
end


