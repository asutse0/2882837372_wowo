		tab.Window = window
		tab.Name = tabName

		local button = make("TextButton", {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = Library.Theme.Panel2,
			BorderSizePixel = 0,
			Text = tostring(tabName or "Tab"),
			TextColor3 = Library.Theme.Text,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			AutoButtonColor = false,
			Parent = tabBar
		})

		corner(button, 9)
		hover(button, Library.Theme.Panel2, Library.Theme.Panel3)

		local page = make("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Library.Theme.Panel,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = Library.Theme.Accent,
			CanvasSize = UDim2.fromOffset(0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
			Parent = content
		})

		corner(page, 13)
		stroke(page, Library.Theme.StrokeSoft, 1, 0.22)
		padding(page, 9, 9, 9, 9)

		make("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = page
		})

		tab.Button = button
		tab.Page = page

		function tab:Show()
			for _, other in ipairs(window.Tabs) do
				other.Page.Visible = false
				other.Button.BackgroundColor3 = Library.Theme.Panel2
			end

			page.Visible = true
			button.BackgroundColor3 = Library.Theme.Accent
			window.CurrentTab = tab
		end

		button.MouseButton1Click:Connect(function()
			tab:Show()
		end)

		function tab:AddLabel(text)
			return make("TextLabel", {
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundTransparency = 1,
				Text = tostring(text or "Label"),
				TextColor3 = Library.Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				Parent = page
			})
		end

		function tab:AddButton(text, callback)
			local btn = make("TextButton", {
				Size = UDim2.new(1, 0, 0, 35),
				BackgroundColor3 = Library.Theme.Button,
				BorderSizePixel = 0,
				Text = tostring(text or "Button"),
				TextColor3 = Library.Theme.Text,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				AutoButtonColor = false,
				Parent = page
			})

			corner(btn, 9)
			hover(btn, Library.Theme.Button, Library.Theme.ButtonHover)

			btn.MouseButton1Click:Connect(function()
				if callback then
					task.spawn(callback)
				end
			end)

			return btn
		end

		function tab:AddTextbox(config)
			config = config or {}

			local box = make("TextBox", {
				Size = UDim2.new(1, 0, 0, config.Height or 38),
				BackgroundColor3 = Library.Theme.Panel2,
				BorderSizePixel = 0,
				PlaceholderText = config.Placeholder or "Text...",
				PlaceholderColor3 = Library.Theme.Muted,
				Text = config.Default or "",
				TextColor3 = Library.Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				Font = Enum.Font.Gotham,
				TextSize = 12,
				MultiLine = config.MultiLine or false,
				ClearTextOnFocus = false,
				Parent = page
			})

			corner(box, 9)
			stroke(box, Library.Theme.StrokeSoft, 1, 0.25)
			padding(box, 9, 9, 7, 7)

			return box
		end

		function tab:AddDropdown(config)
			config = config or {}
			local options = config.Options or {}
			local selected = config.Default or options[1] or "Select"

			local holder = make("Frame", {
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundTransparency = 1,
				ClipsDescendants = false,
				Parent = page
			})

			local button = make("TextButton", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Library.Theme.Button,
				BorderSizePixel = 0,
				Text = tostring(selected),
				TextColor3 = Library.Theme.Text,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
				Parent = holder
			})

			corner(button, 9)
			hover(button, Library.Theme.Button, Library.Theme.ButtonHover)

			local dropdown = {}
			dropdown.Value = selected
			dropdown.Options = options
			dropdown.Button = button

			local index = 1
			button.MouseButton1Click:Connect(function()
				if #dropdown.Options == 0 then
					return
				end

				index += 1

				if index > #dropdown.Options then
					index = 1
				end

				dropdown:Set(dropdown.Options[index])
			end)

			function dropdown:Set(value)
				dropdown.Value = tostring(value)
				button.Text = dropdown.Value

				if config.Callback then
					task.spawn(config.Callback, dropdown.Value)
				end

				return dropdown
			end

			function dropdown:SetOptions(newOptions)
				dropdown.Options = newOptions or {}
				return dropdown
			end

			return dropdown
		end

		function tab:AddToggle(config)
			config = config or {}

			local state = config.Default or false

			local btn = make("TextButton", {
				Size = UDim2.new(1, 0, 0, 35),
				BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Button,
				BorderSizePixel = 0,
				Text = tostring(config.Text or "Toggle") .. ": " .. tostring(state),
				TextColor3 = Library.Theme.Text,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				AutoButtonColor = false,
				Parent = page
			})

			corner(btn, 9)

			btn.MouseButton1Click:Connect(function()
				state = not state
				btn.Text = tostring(config.Text or "Toggle") .. ": " .. tostring(state)
				btn.BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Button

				if config.Callback then
					task.spawn(config.Callback, state)
				end
			end)

			return {
				Button = btn,

				Get = function()
					return state
				end,

				Set = function(_, value)
					state = value
					btn.Text = tostring(config.Text or "Toggle") .. ": " .. tostring(state)
					btn.BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Button
				end
			}
		end

		table.insert(window.Tabs, tab)

		if not window.CurrentTab then
			tab:Show()
		end

		return tab
	end

	table.insert(self.Windows, window)

	main.Size = UDim2.fromOffset(0, 0)

	task.defer(function()
		tween(main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = window.Size
		})
	end)

	return window
end

